*DIM,TOLD,ARRAY,303
*DIM,COLD,ARRAY,303
*VFILL,TOLD(1),RAMP,28,0
*VFILL,COLD(1),RAMP,2.55,0
*DIM,TCOL,ARRAY,101
*DIM,RAD,ARRAY,101
*VFILL,RAD(1),RAMP,0,0.0002
FINISH
/SOLU
ANTYPE,TRANS
TRNOPT,FULL
TINTP,1
AUTOTS,OFF
KBC,0
TUNIF,28
NSEL,S,NODE,,1,303
IC,ALL,TEMP,28
NSEL,S,NODE,,304,606
IC,ALL,TEMP,2.55
NSEL,S,NODE,,1,303
NSEL,R,LOC,X,.02
SF,ALL,CONV,25,%TAIR%
NSEL,S,NODE,,304,606
NSEL,R,LOC,X,.02
SF,ALL,CONV,800,%CAIR%
ALLSEL,ALL
OUTPR,ALL,NONE
OUTRES,ERASE
OUTRES,NSOL,ALL
RESCONTROL,DEFINE,NONE
*CFOPEN,radial,csv
*DO,STEP,1,11500
/SOLU
*DO,IE,1,200
CMID=0
TMID=0
*DO,JK,1,4
INOD=CONNECT(IE,JK)
CMID=CMID+COLD(INOD)/4
TMID=TMID+TOLD(INOD)/4
*ENDDO
WET=CMID/(1+CMID)
RHO=650+128*CMID
CPVAL=1450+2736*WET
KVAL=.21+.38*WET
DIFF=2.4e6*EXP(-.45/CMID)*EXP(-3850/(TMID+273.15))
MP,KXX,IE,KVAL
MP,DENS,IE,RHO
MP,C,IE,CPVAL
IMAT=IE+200
MP,KXX,IMAT,DIFF
*ENDDO
TNOW=STEP*20
TIME,TNOW
NSUBST,1,1,1
SOLVE
*VLEN,303
*VGET,TOLD(1),NODE,1,TEMP
*VGET,COLD(1),NODE,304,TEMP
*IF,MOD(STEP,3),EQ,0,THEN
*VFILL,TCOL(1),RAMP,TNOW,0
*VLEN,101
*VWRITE,TCOL(1),RAD(1),TOLD(1),COLD(1)
(3(E24.16,','),E24.16)
*ENDIF
*ENDDO
*CFCLOS
FINISH
/POST1
SET,LAST
*CFOPEN,final_nodes,csv
*VLEN,1
*DO,INOD,1,303
*GET,RVAL,NODE,INOD,LOC,X
*GET,ZVAL,NODE,INOD,LOC,Y
TVALUE=TOLD(INOD)
CVALUE=COLD(INOD)
*VWRITE,INOD,RVAL,ZVAL,TVALUE,CVALUE
(F12.0,',',3(E24.16,','),E24.16)
*ENDDO
*CFCLOS
FINISH
SAVE,model,db
/EXIT,NOSAVE
